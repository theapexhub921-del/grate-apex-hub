{
  "expo": {
    "name": "GrAte Apex Hub",
    "slug": "grateapex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/grateapex-app-icon.png",
    "scheme": "grateapex",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.grateapex.app",
      "icon": "./assets/images/grateapex-app-icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.grateapex.app",
      "adaptiveIcon": {
        "backgroundColor": "#1436B8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/grateapex-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1245C4",
          "image": "./assets/images/grateapex-logo.png",
          "imageWidth": 280
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0ce8287-44e7-4d85-a445-121d61ae88f4"
      }
    },
    "owner": "grateapex"
  }
}
